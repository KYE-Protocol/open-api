GET /v1/data-assets listDataAssets @auth=inherit @purpose=Operate.Read @idempotent | tenant_id:string?,classification:string?,owner:string? -> opaque
POST /v1/data-assets registerDataAsset @auth=inherit @purpose=Operate.Read | body:Body -> opaque
GET /v1/data-assets/{asset_id} readDataAsset @auth=inherit @purpose=Operate.Read @idempotent | asset_id:string -> opaque
GET /v1/data-use-manifests listDataUseManifests @auth=inherit @purpose=Operate.Read @idempotent | tenant_id:string?,subject:string?,active:boolean? -> opaque
POST /v1/data-use-manifests registerDataUseManifest @auth=inherit @purpose=Operate.Read | body:Body -> opaque
