GET /api/v1/state-events state.listStateEvents @auth=inherit @purpose=Operate.Read @idempotent | entity_id:string?,machine_id:string?,from:string?,to:string? -> object
POST /api/v1/state-events fireStateEvent @auth=inherit @purpose=Operate.Read | body:Body -> object
GET /api/v1/state-machines state.listStateMachines @auth=inherit @purpose=Operate.Read @idempotent | tenant_id:string?,entity_class:string?,scope:string? -> object
POST /api/v1/state-machines state.createStateMachine @auth=inherit @purpose=Operate.Read | body:Body -> object
POST /api/v1/state-machines/from-library adoptStateLibraryEntry @auth=inherit @purpose=Operate.Read | body:Body -> object
GET /api/v1/state-machines/{machine_id} getStateMachine @auth=inherit @purpose=Operate.Read @idempotent | ∅ -> object
GET /api/v1/state-registry/{tenant_id} getStateRegistry @auth=inherit @purpose=Operate.Read @idempotent | ∅ -> object
